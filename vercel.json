{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/contact", "destination": "/pages/contact.html" },
    { "source": "/faq", "destination": "/pages/faq.html" },
    { "source": "/privacy", "destination": "/pages/privacy.html" },
    { "source": "/terms", "destination": "/pages/terms.html" },
    { "source": "/track-order", "destination": "/pages/track-order.html" },
    { "source": "/accounts/login", "destination": "/pages/accounts/login.html" },
    { "source": "/accounts/signup", "destination": "/pages/accounts/signup.html" }
  ]
}